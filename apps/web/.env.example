# Neon / Postgres (server-only — do not use NEXT_PUBLIC_)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT signing secret for /api/auth/* (server-only). Generate a long random string.
AUTH_SECRET=

# Optional external API base. Leave empty to use same-origin Next routes (/api/...).
# Example: http://localhost:4000
NEXT_PUBLIC_API_URL=

# DB isolation (automatic via NODE_ENV — do not override in app code):
# - development (next dev) → schema antiq_dev only (never writes public.users)
# - production → schema public
# Local migrate: pnpm --filter @antiq/web db:migrate  (creates antiq_dev.* only)

# Spotify Web API (Client Credentials) — enables real artist + top tracks on profiles.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Instagram Graph API (Business Discovery) — Connect profile grid for other Professional accounts.
# 1. developers.facebook.com → Create App → add Instagram
# 2. Link a Professional IG account to a Facebook Page
# 3. Long-lived Page/System User token with Business Discovery permissions
#    (instagram_basic, pages_show_list, instagram_manage_insights — see current Meta docs)
# 4. META_IG_BUSINESS_ID = your business Instagram user id (not the artist’s)
# Dev: add testers in app roles. Prod: App Review required.
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
